<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 인증 토큰이 저장된 DataStore 파일을 클라우드 백업에서 제외합니다. -->
        <exclude
            domain="file"
            path="datastore/yadan_preferences.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <!-- 인증 토큰이 저장된 DataStore 파일을 기기 간 이전에서 제외합니다. -->
        <exclude
            domain="file"
            path="datastore/yadan_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
